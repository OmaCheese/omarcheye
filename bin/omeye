#!/bin/bash
# omeye launcher: runs the package from this checkout with its own environment.
root=$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")
if [[ ! -x $root/.venv/bin/python ]]; then
  echo "omeye: no Python environment in $root; run $root/install.sh" >&2
  exit 1
fi
PYTHONPATH=$root exec "$root/.venv/bin/python" -m omeye "$@"
