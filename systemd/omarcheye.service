# Template: install.sh puts in the checkout path and copies it to ~/.config/systemd/user.
# Not enabled at login; `omarcheye on|off|toggle` starts and stops it.
[Unit]
Description=omarch-eye: focus the window you look at
Documentation=file://@ROOT@/README.md
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
ExecStart=@ROOT@/bin/omarcheye run --verbose
Restart=on-failure
RestartSec=2
Nice=10
